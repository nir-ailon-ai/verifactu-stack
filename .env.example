# Copy this file to .env and fill in real values. NEVER commit .env.

# MariaDB
MARIADB_ROOT_PASSWORD=CHANGEME_root_password
MARIADB_DATABASE=facturascripts
MARIADB_USER=fsuser
MARIADB_PASSWORD=CHANGEME_fsuser_password

# Anthropic API key for incoming invoice AI extraction
ANTHROPIC_API_KEY=sk-ant-CHANGEME

# MinIO (S3-compatible object storage)
# Console UI available at http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGEME_minio_password

# Nginx port binding — defaults are fine for standalone/local use (binds
# 0.0.0.0:80 and 0.0.0.0:443). Override when this stack runs behind a
# shared host-level reverse proxy (e.g. multiple projects on one server,
# each with its own subdomain terminating TLS at the host), so this
# project's nginx only listens on localhost on an unused port instead of
# claiming 80/443 on the host:
#   NGINX_BIND_ADDR=127.0.0.1
#   NGINX_HTTP_PORT=8081
#   NGINX_HTTPS_PORT=8444

# Google sign-in gate for the /gestoria/ upload UI (oauth2-proxy).
# GESTORIA_DOMAIN is the public hostname this is served on (used to build
# the OAuth redirect URL and scope the auth cookie).
GESTORIA_DOMAIN=gestoria.example.com
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application, redirect URI https://<GESTORIA_DOMAIN>/oauth2/callback)
OAUTH2_PROXY_CLIENT_ID=CHANGEME.apps.googleusercontent.com
OAUTH2_PROXY_CLIENT_SECRET=CHANGEME
# Random 32-byte value, base64-encoded. Generate with:
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=CHANGEME
# Who's allowed to sign in — see oauth2-proxy/authenticated-emails.txt.example

